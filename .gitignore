pipeline/models/
pipeline/third_party/

# data/ 下只让几 KB 的元数据 JSON 进 git（PLY / SOG / 帧序列 / 编译日志都不进）。
# 注意写法：一旦用 `pipeline/data/` 整体排除目录，git 就不再遍历其中内容，
# 后面的 `!...*.json` 会完全失效 —— 所以这里排除的是目录"里的内容"（/**），
# 再逐级把需要的目录和文件放回来。
pipeline/data/**
!pipeline/data/ply/
!pipeline/data/sog/
!pipeline/data/ply/*.json
!pipeline/data/sog/*.json

# 原始素材：视频动辄几十上百 MB，和 data/ 一样不进 git（§4）
media/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node
node_modules/
web/dist/
# tsc -b 的增量编译缓存
*.tsbuildinfo

# web 的 splat 资产：.sog 成品进 git，这样两台机器直接 git pull 就能拿到，
# 不用再走 NAS / scp（§4）。单个超过 30 MB 的就别提交了，只在部署时上传。
# butterfly.spz 之类的其它二进制格式仍然不进（那是一次性下载的官方参照）。
# 同名 .json 只有几 KB，是前端定相机要用的 —— 写法同 pipeline/data，先排内容再放回来。
web/public/splats/**
!web/public/splats/*.json
!web/public/splats/*.sog

# 编译日志
*.build.log

# 编辑器/系统
.DS_Store
.idea/
.vscode/
